# Telegram Bot Configuration
BOT_TOKEN=your_bot_token_here

# Database Configuration
DATABASE_URL=postgresql+asyncpg://user:password@localhost/dbname

# OpenRouter API Configuration
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Redis Configuration (для хранения контекста)
REDIS_URL=redis://:password@host:port/db
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here

# ARQ Queue Configuration (для фоновых задач)
# По умолчанию использует те же настройки что и Redis, но другую БД
ARQ_REDIS_HOST=localhost
ARQ_REDIS_PORT=6379
ARQ_REDIS_PASSWORD=your_redis_password_here
ARQ_REDIS_DATABASE=1